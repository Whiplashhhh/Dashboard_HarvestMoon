# Copie ce fichier en `.env` pour le développement local : cp .env.example .env
# En production, ces variables sont fournies par Docker Compose (voir docker-compose.yml).

# Connexion PostgreSQL (obligatoire)
NUXT_DATABASE_URL=postgres://carnet:carnet@localhost:5433/carnet

# Secret aléatoire d'au moins 32 caractères, utilisé pour signer les jetons CSRF (obligatoire en production).
# Générer : openssl rand -base64 48
NUXT_SESSION_SECRET=remplace-moi-par-une-longue-chaine-aleatoire-de-32-caracteres-minimum

# URL publique du site (sert à vérifier l'en-tête Origin des requêtes qui modifient des données).
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Mettre à true derrière un reverse proxy (Caddy) pour lire l'IP cliente dans X-Forwarded-For.
NUXT_TRUST_PROXY=false

# Limitation de débit (facultatif) : tentatives de connexion libres par IP avant délai progressif,
# et nombre d'inscriptions par IP et par heure.
# NUXT_AUTH_IP_FREE_ATTEMPTS=20
# NUXT_AUTH_REGISTRATIONS_PER_HOUR=5
